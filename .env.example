# Copy the lines you need into .env (same folder; .env is never committed),
# then restart Amaan (stop.bat, start.bat). Every key is free. A source without
# a key is shown as "Not set up" and skipped. Each source sees only the link.

# Google Safe Browsing: console.cloud.google.com -> enable "Safe Browsing API" -> create API key.
# Only 4-byte hash prefixes of the link are sent, never the link itself. Non-commercial use.
AMAAN_SAFE_BROWSING_KEY=

# VirusTotal: virustotal.com -> sign up -> profile -> API key. Lookup only (4 per minute).
AMAAN_VIRUSTOTAL_KEY=

# urlscan.io: urlscan.io -> sign up -> Settings & API -> new API key. Scans are private.
AMAAN_URLSCAN_KEY=

# URLhaus (abuse.ch): auth.abuse.ch -> sign in -> Optional -> generate Auth-Key. List is downloaded.
AMAAN_URLHAUS_KEY=

# OpenPhish's list is downloaded without a key. Set to 0 to turn list downloads off.
AMAAN_FEEDS_ENABLED=1
