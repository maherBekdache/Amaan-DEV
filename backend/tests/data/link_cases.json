    {"link": "which.com", "absent": ["typo_domain", "lookalike_domain", "brand_in_domain"]},
    {"link": "finance.com", "absent": ["typo_domain"]},
    {"link": "cloud.com", "absent": ["typo_domain"]},
    {"link": "tough.com", "absent": ["typo_domain"]},
    {"link": "apply.com", "absent": ["typo_domain"]},
